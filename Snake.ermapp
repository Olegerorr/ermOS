{
  "manifest": {
    "name": "Snake",
    "id": "ermos.snake",
    "version": "1.3",
    "iconBase64": "data:image/svg+xml;base64,",
    "description": "Classic Snake game with wall wrapping",
    "permissions": []
  },
  "html": "<!doctype html><html><meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\"><title>Snake</title><style>*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{height:100%;overflow:hidden}body{font-family:-apple-system,system-ui,sans-serif;background:linear-gradient(160deg,#0b1026,#1b2a5e);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;user-select:none;-webkit-user-select:none}.top{padding:14px 16px 8px;width:100%;display:flex;align-items:center;justify-content:space-between;gap:8px}.score{font-size:14px;font-weight:700}.score span{color:#34d158}.best{font-size:12px;opacity:.7}.board-wrap{position:relative;margin:6px auto;padding:0 12px;width:100%;display:flex;justify-content:center}.board{position:relative;background:#0d1a2e;border-radius:18px;box-shadow:0 10px 40px #0007,inset 0 0 0 1px #ffffff10;overflow:hidden;touch-action:none}canvas{display:block}.overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:20px;background:#0b1026e6;backdrop-filter:blur(6px);z-index:2;border-radius:18px}.overlay h2{font-size:22px;margin-bottom:8px}.overlay p{font-size:13px;opacity:.75;line-height:1.5;margin-bottom:16px}.overlay button{border:0;border-radius:22px;background:#34d158;color:#0b1026;font-weight:700;font-size:15px;padding:12px 26px;cursor:pointer}.overlay button:active{transform:scale(.96)}.controls{display:grid;grid-template-columns:repeat(3,58px);grid-template-rows:repeat(3,58px);gap:8px;margin:14px auto 22px;justify-content:center}.controls button{border:0;border-radius:14px;background:#ffffff1a;color:#fff;font-size:22px;cursor:pointer;display:grid;place-items:center}.controls button:active{background:#ffffff33}.controls .spacer{visibility:hidden}.footer{font-size:11px;opacity:.5;padding-bottom:14px}.err{position:absolute;left:8px;right:8px;bottom:8px;background:#7d1e2a;color:#fff;font-size:11px;padding:8px;border-radius:8px;z-index:99;font-family:monospace;display:none}</style><body><div class=\"top\"><div class=\"score\">Score: <span id=\"score\">0</span></div><div class=\"best\">Best: <span id=\"best\">0</span></div></div><div class=\"board-wrap\"><div class=\"board\" id=\"board\"><canvas id=\"cv\"></canvas><div class=\"overlay\" id=\"ov\"><h2 id=\"ovTitle\">Snake</h2><p id=\"ovText\">Use arrows, WASD or swipe.<br>Eat apples and avoid yourself!<br><small style=\"opacity:.6;font-size:11px\">Walls wrap around</small></p><button id=\"start\" type=\"button\">Play</button></div></div></div><div class=\"controls\" id=\"ctrl\"><div class=\"spacer\"></div><button type=\"button\" data-dir=\"up\">▲</button><div class=\"spacer\"></div><button type=\"button\" data-dir=\"left\">◀</button><div class=\"spacer\"></div><button type=\"button\" data-dir=\"right\">▶</button><div class=\"spacer\"></div><button type=\"button\" data-dir=\"down\">▼</button><div class=\"spacer\"></div></div><div class=\"footer\">ermOS · Snake 1.3</div><div class=\"err\" id=\"err\"></div><script>(function(){function boot(){var errEl=document.getElementById('err');function showErr(m){if(!errEl)return;errEl.textContent=String(m);errEl.style.display='block'}try{var CELL=20,COLS=16,ROWS=16,W=CELL*COLS,H=CELL*ROWS;var cv=document.getElementById('cv');if(!cv)throw new Error('canvas not found');var ctx=cv.getContext('2d');var board=document.getElementById('board');var ov=document.getElementById('ov'),ovTitle=document.getElementById('ovTitle'),ovText=document.getElementById('ovText'),startBtn=document.getElementById('start');var scoreEl=document.getElementById('score'),bestEl=document.getElementById('best');if(!ctx||!board||!ov||!startBtn)throw new Error('DOM elements missing');var dpr=Math.min(2,window.devicePixelRatio||1);cv.width=W*dpr;cv.height=H*dpr;cv.style.width=W+'px';cv.style.height=H+'px';ctx.setTransform(dpr,0,0,dpr,0,0);var snake,dir,nextDir,food,score,running,loopId;var best=0;try{best=Number(localStorage.getItem('ermos-snake-best')||0)||0}catch(e){}bestEl.textContent=best;function roundRect(x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();ctx.fill()}function placeFood(){var empty=[];for(var y=0;y<ROWS;y++)for(var x=0;x<COLS;x++){if(!snake.some(function(s){return s.x===x&&s.y===y}))empty.push({x:x,y:y})}food=empty.length?empty[Math.floor(Math.random()*empty.length)]:{x:0,y:0}}function reset(){snake=[{x:8,y:8},{x:7,y:8},{x:6,y:8}];dir={x:1,y:0};nextDir={x:1,y:0};score=0;scoreEl.textContent='0';placeFood();draw()}function draw(){ctx.fillStyle='#0d1a2e';ctx.fillRect(0,0,W,H);ctx.strokeStyle='#ffffff08';ctx.lineWidth=1;for(var i=1;i<COLS;i++){ctx.beginPath();ctx.moveTo(i*CELL,0);ctx.lineTo(i*CELL,H);ctx.stroke()}for(var j=1;j<ROWS;j++){ctx.beginPath();ctx.moveTo(0,j*CELL);ctx.lineTo(W,j*CELL);ctx.stroke()}if(food){ctx.fillStyle='#ff453a';ctx.beginPath();ctx.arc(food.x*CELL+CELL/2,food.y*CELL+CELL/2,CELL*0.38,0,Math.PI*2);ctx.fill();ctx.fillStyle='#ff6b62';ctx.beginPath();ctx.arc(food.x*CELL+CELL/2-3,food.y*CELL+CELL/2-3,CELL*0.14,0,Math.PI*2);ctx.fill()}for(var k=snake.length-1;k>=0;k--){var s=snake[k];var t=1-k/snake.length;var r=Math.round(52+(-30)*t),g=Math.round(209+(-60)*t),b=Math.round(88+(-20)*t);ctx.fillStyle='rgb('+r+','+g+','+b+')';roundRect(s.x*CELL+2,s.y*CELL+2,CELL-4,CELL-4,6);if(k===0){ctx.fillStyle='#0b1026';ctx.beginPath();ctx.arc(s.x*CELL+7,s.y*CELL+7,2,0,Math.PI*2);ctx.arc(s.x*CELL+13,s.y*CELL+7,2,0,Math.PI*2);ctx.fill()}}}function tick(){if(!running)return;dir=nextDir;var head={x:snake[0].x+dir.x,y:snake[0].y+dir.y};if(head.x<0)head.x=COLS-1;else if(head.x>=COLS)head.x=0;if(head.y<0)head.y=ROWS-1;else if(head.y>=ROWS)head.y=0;if(snake.some(function(s,i){if(i===snake.length-1)return false;return s.x===head.x&&s.y===head.y})){gameOver();return}snake.unshift(head);if(head.x===food.x&&head.y===food.y){score++;scoreEl.textContent=String(score);if(score>best){best=score;bestEl.textContent=String(best);try{localStorage.setItem('ermos-snake-best',String(best))}catch(e){}}placeFood()}else snake.pop();draw()}function gameOver(){running=false;if(loopId){clearInterval(loopId);loopId=null}ov.style.display='flex';ovTitle.textContent='Game Over';ovText.innerHTML='Score: <b>'+score+'</b><br>Best: <b>'+best+'</b>';startBtn.textContent='Play Again'}function start(){try{ov.style.display='none';reset();running=true;if(loopId)clearInterval(loopId);loopId=setInterval(tick,110)}catch(e){showErr(e&&e.message?e.message:e)}}function setDir(d){var map={up:{x:0,y:-1},down:{x:0,y:1},left:{x:-1,y:0},right:{x:1,y:0}};var nd=map[d];if(!nd)return;if(nd.x===-dir.x&&nd.y===-dir.y)return;nextDir=nd}startBtn.addEventListener('click',start);var ctrl=document.getElementById('ctrl');if(ctrl)ctrl.querySelectorAll('button[data-dir]').forEach(function(b){b.addEventListener('click',function(){setDir(b.getAttribute('data-dir'))})});document.addEventListener('keydown',function(e){var k=(e.key||'').toLowerCase();if(k==='arrowup'||k==='w')setDir('up');else if(k==='arrowdown'||k==='s')setDir('down');else if(k==='arrowleft'||k==='a')setDir('left');else if(k==='arrowright'||k==='d')setDir('right');else if(k===' '||k==='enter'){if(!running){try{start()}catch(err){}}}if(['arrowup','arrowdown','arrowleft','arrowright',' '].indexOf(k)>=0)e.preventDefault()});var ts=null;board.addEventListener('touchstart',function(e){var t=e.changedTouches[0];ts={x:t.clientX,y:t.clientY}},{passive:true});board.addEventListener('touchend',function(e){if(!ts)return;var t=e.changedTouches[0];var dx=t.clientX-ts.x,dy=t.clientY-ts.y;if(Math.abs(dx)<12&&Math.abs(dy)<12)return;if(Math.abs(dx)>Math.abs(dy))setDir(dx>0?'right':'left');else setDir(dy>0?'down':'up');ts=null},{passive:true});reset();ov.style.display='flex'}catch(e){showErr(e&&e.stack?e.stack:(e&&e.message?e.message:e))}}if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',boot)}else{boot()}})();<\/script></body></html>"
}